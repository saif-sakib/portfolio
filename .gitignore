# Dependencies
node_modules/

# Astro build output and cache
site/dist/
site/.astro/

# CV PDFs are build output: ./cv/build.sh writes cv/pdf/ (CI builds them for the site),
# and the site build copies them into site/public/cv/.
cv/pdf/
site/public/cv/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Private job-search notes (kept local only)
job-hunt/

# Env / secrets
.env
.env.*
!.env.example

# Logs
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
